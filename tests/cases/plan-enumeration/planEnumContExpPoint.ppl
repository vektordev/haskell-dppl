-- M3 peel through exp, POINT observation inside the image: exp leaf == 2
-- pins the leaf at log 2 with change-of-variables factor 1/2: phi(log 2) / 2
-- at dim 1; the False outcome has full mass at dim 0.
neural readObj :: (Symbol -> (Bool, Float))

main sym = let o = readObj sym in if exp (snd o) == 2.0 then 1 else 0
