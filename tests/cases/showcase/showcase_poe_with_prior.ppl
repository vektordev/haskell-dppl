-- Showcase Level 4 (design sum-type-showcase): a symbolic prior fused with two
-- neural likelihoods. The prior is an ordinary SPLL branch, so the kept mass is
-- P_prior(k) * P_cam(k) * P_depth(k) -- prior times likelihood, unnormalized;
-- dividing by `p(Just ANY)` renormalizes it.
neural camNN   :: (Symbol -> Int) of [0, 1, 2]
neural depthNN :: (Symbol -> Int) of [0, 1, 2]
prior = if Uniform < 0.5 then 0 else if Uniform < 0.5 then 1 else 2
main img depth =
  let v = prior in
  let c = camNN img in
  let d = depthNN depth in
  if (v == c) && (v == d) then right v else left ()
