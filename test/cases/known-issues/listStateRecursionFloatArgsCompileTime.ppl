canFin pEnd pOpen pClose cap st len k =
  if cap < len then False
  else if k == 0 then isNull st
  else if Uniform < pEnd then isNull st
  else if Uniform < pOpen then
    (if Uniform < 0.5 then canFin pEnd pOpen pClose cap (0 : st) (len + 1) (k - 1)
     else canFin pEnd pOpen pClose cap (1 : st) (len + 1) (k - 1))
  else if Uniform < pClose then
    (if isNull st then False
     else if Uniform < 0.5 then (if head st == 0 then canFin pEnd pOpen pClose cap (tail st) (len + 1) (k - 1) else False)
     else (if head st == 1 then canFin pEnd pOpen pClose cap (tail st) (len + 1) (k - 1) else False))
  else canFin pEnd pOpen pClose cap st (len + 1) (k - 1)

main pEnd pOpen pClose cap st len k = canFin pEnd pOpen pClose cap st len k
