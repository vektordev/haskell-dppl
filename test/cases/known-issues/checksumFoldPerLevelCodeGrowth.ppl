data Digit = N0 | N1 | N2 | N3 | N4 | N5 | N6 | N7 | N8 | N9
data DigitList = DEnd | DCons dig::Digit, rest::DigitList depth {{N}}
val d = if isN0 d then 0 else if isN1 d then 1 else if isN2 d then 2 else if isN3 d then 3 else if isN4 d then 4 else if isN5 d then 5 else if isN6 d then 6 else if isN7 d then 7 else if isN8 d then 8 else 9
cs a b ds = if isDEnd ds then 0 else a*(val (dig ds)) + cs b a (rest ds)
neural readDigits :: (Symbol -> DigitList)
main sym = draw ds = readDigits sym in cs 1 3 ds
