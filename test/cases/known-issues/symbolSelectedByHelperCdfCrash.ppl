-- A board of image Symbols, one picked by a random index through a helper.
-- The probability path compiles and answers; the default compile crashes in
-- the CDF (integrate) path with an `error` call rather than a diagnostic:
-- "Comparison not implemented for type: TSymbol". `-I` (no integrate) is a
-- complete workaround. The same selection written inline
-- (`see (if s == 0 then a else b)`) compiles. Task
-- symbol-selected-by-helper-crashes-cdf-compile.
neural see :: (Symbol -> Bool)
neural pick :: (Symbol -> Int) of [0, 1]
main p board = draw s = pick p in draw t = see (nth s board) in (s, t)
nth k xs = if k == 0 then head xs else nth (k - 1) (tail xs)
