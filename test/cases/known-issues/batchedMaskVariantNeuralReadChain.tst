-- Found by experiments_nest lm-product-of-experts-decoding (2026-10-14),
-- filed as batched-mask-variant-neural-read-nests-v-deep. The agreement
-- product spelled with a Bool flag, (a, a == b), over a contiguous 250-value
-- neural domain. It compiles under --batched, but the emitted module does not
-- import: the per-mask variant for a query whose second slot is ANY
-- (Main__m01) reads P(a = sample[0]) as a 250-deep right-nested `+` chain of
-- where_anchored(k == sample[0], raw[..., k], 0.0), past CPython's
-- 200-parenthesis limit ("SyntaxError: too many nested parentheses"). The
-- scalar backend imports and answers these rows. Both experts uniform here.
backends: batched
expect-failure: broken
