data Color = Red | Green | Blue
data Position = Pos x::Float, y::Float
data Object = NoObj | Obj color::Color, position::Position

neural readObj :: (Symbol -> Object)

leftOf a b = if isNoObj a then False else if isNoObj b then False else x (position a) < x (position b)

main s1 s2 = draw a = readObj s1 in draw b = readObj s2 in leftOf a b
