-- A board of image Symbols, one picked by a random index through a helper.
-- The default compile used to crash in nth's integrate variant ("Comparison
-- not implemented for type: TSymbol"; task
-- symbol-selected-by-helper-crashes-cdf-compile), and then compiled generate
-- only, its probability and integrate variants silently absent (task
-- symbol-selected-by-helper-has-no-probability; a known-issues pin until
-- haskell-dppl 7373c79 admitted a neural read whose input is a point once its
-- witnessed variables are fixed: `nth s board` with s observed). The query
-- with s unobserved, p((ANY, True)) = 0.375, is still declined at run time:
-- `main` answers no (ANY, _) mask.
neural see :: (Symbol -> Bool)
neural pick :: (Symbol -> Int) of [0, 1]
main p board = draw s = pick p in draw t = see (nth s board) in (s, t)
nth k xs = if k == 0 then head xs else nth (k - 1) (tail xs)
