neural readD :: (Float -> Int) of [0, 1]
main = draw zs = [Normal, Normal] in (zs, readD (head zs + head (tail zs)))
-- A read whose input combines two witnessed operands: a point given the
-- observation although not one witnessed image (docs ticket
-- neural-read-at-recursive-walk-of-observed-list-no-code). The mock's logits
-- at input v are [v, 1.0]: p(([a, b], 0)) = N(a) N(b) (a + b).
