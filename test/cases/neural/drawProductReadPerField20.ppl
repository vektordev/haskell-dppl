-- drawProductReadPerField at 20 fields: 2^20 Faces jointly, compiled per field.
-- Task draw-product-read-enumerated-jointly.
-- Python-only for the same reason as drawProductReadPerField.
data Face = Face x0::Bool, x1::Bool, x2::Bool, x3::Bool, x4::Bool, x5::Bool, x6::Bool, x7::Bool, x8::Bool, x9::Bool, x10::Bool, x11::Bool, x12::Bool, x13::Bool, x14::Bool, x15::Bool, x16::Bool, x17::Bool, x18::Bool, x19::Bool
neural see :: (Symbol -> Face)
tells yes no truth = if truth then Uniform < yes else Uniform < no
main img =
  draw truth = see img in
  Face
       (tells 0.9 0.2 (x0 truth))
       (tells 0.9 0.2 (x1 truth))
       (tells 0.9 0.2 (x2 truth))
       (tells 0.9 0.2 (x3 truth))
       (tells 0.9 0.2 (x4 truth))
       (tells 0.9 0.2 (x5 truth))
       (tells 0.9 0.2 (x6 truth))
       (tells 0.9 0.2 (x7 truth))
       (tells 0.9 0.2 (x8 truth))
       (tells 0.9 0.2 (x9 truth))
       (tells 0.9 0.2 (x10 truth))
       (tells 0.9 0.2 (x11 truth))
       (tells 0.9 0.2 (x12 truth))
       (tells 0.9 0.2 (x13 truth))
       (tells 0.9 0.2 (x14 truth))
       (tells 0.9 0.2 (x15 truth))
       (tells 0.9 0.2 (x16 truth))
       (tells 0.9 0.2 (x17 truth))
       (tells 0.9 0.2 (x18 truth))
       (tells 0.9 0.2 (x19 truth))
