data Color = Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple
data Shape = Cube | Sphere | Cylinder
data Object = Nil | Obj shape::Shape, color::Color
data Scene = Scene o1::Object, o2::Object, o3::Object, o4::Object, o5::Object, o6::Object, o7::Object, o8::Object, o9::Object, o10::Object

neural extract :: (Symbol -> Scene) of {Scene {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}} {Nil | Obj {Cube | Sphere | Cylinder} {Red | Blue | Green | Yellow | Grey | Brown | Cyan | Purple}}}

isR o = if isObj o then (if isRed (color o) then 1 else 0) else 0
main sym = draw sc = extract sym in isR (o1 sc) ++ isR (o2 sc) ++ isR (o3 sc) ++ isR (o4 sc) ++ isR (o5 sc) ++ isR (o6 sc) ++ isR (o7 sc) ++ isR (o8 sc) ++ isR (o9 sc) ++ isR (o10 sc)
