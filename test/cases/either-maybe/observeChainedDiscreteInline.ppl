-- observeChainedDiscrete with the chaining written inline over a draw-bound
-- Maybe instead of through a named function; the two must agree row for row.
main = draw m = observe (if Uniform < 0.3 then 1 else if Uniform < 0.5 then 2 else 0) (\u -> u > 0) in if isRight m then observe (fromRightPartial m) (\w -> w == 1) else left ()
