data Color = Red | Green
data Object = Nil | Obj color::Color, px::Float
data Scene = Scene o1::Object, o2::Object
neural readScene :: (Symbol -> Scene)
recolor o = if isObj o then (if isRed (color o) then Obj Green (px o) else o) else o
main sym = draw sc = readScene sym in Scene (recolor (o1 sc)) (recolor (o2 sc))
-- A per-slot recolour over a product read with a Float leaf, compiled by the
-- plan engine, queried with a wildcard field. The user-ADT constructor case of
-- planInvertNode used not to split a wildcard field ('planAnySplit') and raised
-- "isObj: constructor test on an unobserved value (ANY)" in Python and in the
-- IR interpreter (was known-issues/planCtorFieldPartialAnyCrashes; fixed with
-- task writelogits-dropped-for-read-passthrough-continuous-leaf, docs task
-- plan-ctor-field-partial-any-crashes).
-- p(Scene ANY (Obj Green 1.0)) = 0.4 phi(0)/2 at dim 1, p(Scene ANY Nil) = 0.6.
