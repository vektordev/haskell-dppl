-- A plan-answered count plus an independent discrete draw. DrawSinking moves
-- both draws into the plus's operands --
-- (draw scene = readScene sym in numRed scene) + (draw c = Uniform < 0.5 in if c then 1.0 else 0.0)
-- -- so the plus is an ordinary two-random-operand InjF. The count carries no
-- DiscreteValues tag (Analysis does not look through the recursive numRed), so
-- the plus takes the mixed enumerate-and-shift/scale rule: enumerate the coin
-- side, invert onto the count, which the plan path answers as a mass. That
-- rule used to stamp dim 1 on the sum because its other operand is a Float;
-- it now keeps each term's own dim (enumMixP), so the sum of two discrete
-- operands is a mass (task plan-sum-with-sunk-discrete-draw-reports-density;
-- formerly known-issues/planSumWithSunkDiscreteDrawDim, pinned at dim 1).
--
-- ORACLE: p(v) = 0.5 * P(numRed = v) + 0.5 * P(numRed = v - 1), with numRed's
-- law at these logits from planOverBudgetPlusIf's dense oracle: P(0) =
-- 0.6704985969, P(1) = 0.2900826155, P(2) = 0.0344722817, P(3) = 0.0044528186.
-- A non-integer point reaches no count on either side: impossible.
data Color = Red | Green | Blue
data Object = NoObj | Obj color::Color
data Scene = Empty | SCons obj::Object, rest::Scene depth 7

neural readScene :: (Symbol -> Scene) of 7x.{Empty | SCons {NoObj | Obj {Red|Green|Blue}} x}

numRed s = if isEmpty s then 0.0 else (if isObj (obj s) then (if isRed (color (obj s)) then 1.0 else 0.0) else 0.0) + numRed (rest s)

main sym = draw c = Uniform < 0.5 in draw scene = readScene sym in numRed scene + (if c then 1.0 else 0.0)
