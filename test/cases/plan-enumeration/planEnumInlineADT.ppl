-- Plan-guided lazy enumeration (M1): field accessors on a neural ADT with
-- fields (accessor descent slices the constructor's field sub-plan). `Obj` has
-- a lone constructor, so its region has no flag slot and the descent adds no
-- flag constraint (task plan-emits-vacuous-single-constructor-flags); the
-- multi-constructor case, where it does, is planEnumRecScan's.
-- No `of` clause -- lazy path only.
data Color = Red | Green | Blue
data Obj = Mk c :: Color, f :: Bool
neural readObj :: (Symbol -> Obj)
main sym = draw o = readObj sym in if isRed (c o) then (if f o then 0 else 1) else 2
