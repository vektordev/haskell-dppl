-- A per-slot recolour over a product read whose objects carry a Float leaf
-- (task scene-float-passthrough-edit-exponential). Each field of the rebuilt
-- Scene has several worlds (Nil; Obj read Red and recoloured; Obj read Green
-- and passed through), some holding a point density on px, so the value DP
-- cannot merge them and the cross product of the fields' worlds was c^N.
-- 'planFieldProduct' now measures each field once and multiplies.
-- Plan per Object: [Nil, Obj | Red, Green | mu, sigma]; slot 1
-- [0.3, 0.7, 0.4, 0.6, 0.0, 1.0], slot 2 [0.6, 0.4, 0.9, 0.1, 1.0, 2.0].
-- Hand values: recolor's output is Nil w.p. pNil, Obj Green x at density
-- pObj * N(x; mu, sigma), never Obj Red.
-- p(Scene (Obj Green 0.5) Nil)           = 0.7 phi(0.5) * 0.6            (dim 1)
-- p(Scene (Obj Green 0.5) (Obj Green 1)) = 0.7 phi(0.5) * 0.4 phi(0)/2   (dim 2)
-- p(Scene Nil Nil)                       = 0.3 * 0.6                     (dim 0)
-- p(Scene Nil (Obj Green 0.5))           = 0.3 * 0.4 phi(0.25)/2         (dim 1)
-- No partial-ANY rows: p(Scene ANY ...) raises (isObj on ANY) on this shape
-- with or without the field factoring -- the user-ADT constructor case does
-- not split a wildcard field the way tuples do ('planAnySplit').
data Color = Red | Green
data Object = Nil | Obj color::Color, px::Float
data Scene = Scene o1::Object, o2::Object
neural readScene :: (Symbol -> Scene)
recolor o = if isObj o then (if isRed (color o) then Obj Green (px o) else o) else o
main sym = draw sc = readScene sym in Scene (recolor (o1 sc)) (recolor (o2 sc))
