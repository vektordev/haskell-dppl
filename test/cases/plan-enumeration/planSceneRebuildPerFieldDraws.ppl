-- Each slot draw-bound through an accessor of its own read, `draw a = ob1
-- (readScene sym)` (task scene-rebuild-with-float-leaf-loses-probability; was
-- the known-issues pin sceneRebuildPerFieldDrawsNoCode). The plan engine used
-- to be entered only for a binding of a bare read; a field accessor chain over
-- one now binds the slice ('planProjectedReadOf'). The two reads are
-- independent draws of the same network output.
-- Plan per Object as in planSceneRebuildShiftedFloatLeaf: slot 1
-- [0.3, 0.7, 0.4, 0.6, 0.0, 1.0], slot 2 [0.6, 0.4, 0.9, 0.1, 1.0, 2.0].
-- p(Scene (Obj Red 0.5) Nil)           = 0.7 phi(0.5) * 0.6                (dim 1)
-- p(Scene Nil (Obj Green 1.0))         = 0.3 * 0.4 * 0.1 phi(0)/2          (dim 1)
-- p(Scene (Obj Red 0.5) (Obj Red 1.0)) = 0.7 phi(0.5) * 0.4 * 0.9 phi(0)/2 (dim 2)
-- p(Scene (Obj Green 0.5) Nil)         = 0 (slot 1 is always recoloured)
data Color = Red | Green
data Object = Nil | Obj color::Color, px::Float
data Scene = Scene ob1::Object, ob2::Object
neural readScene :: (Symbol -> Scene)
main sym = draw a = ob1 (readScene sym) in draw b = ob2 (readScene sym) in Scene (if isObj a then Obj Red (px a) else a) b
