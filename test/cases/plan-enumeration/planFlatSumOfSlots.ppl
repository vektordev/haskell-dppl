-- Counting over a fixed-width product scene (the layout of the CLEVR
-- experiments' scene_ae.ppl: ten `Object` fields, not a cons list). A flat `+`
-- of two plan-dependent summands used to be refused by the plan traversal
-- ("unsupported node in plan traversal: InjF plus"; task
-- plan-flat-sum-of-plan-dependent-summands, formerly a known issue). Arithmetic
-- at the observed position is now enumerated by value (task
-- plan-path-coverage-for-over-budget-bodies). The positions only force the plan
-- route (no `of` clause). Slot existence (0.8, 0.9), positions N(0,1), N(1,2):
-- q1 = 0.8 * (1 - Phi(0.5)) = 0.246830, q2 = 0.9 * (1 - Phi(-0.25)) = 0.538836,
-- p(1.0) = q1 (1 - q2) + (1 - q1) q2 = 0.519664, p(0.0) = (1-q1)(1-q2) =
-- 0.347335, p(2.0) = q1 q2 = 0.133001.
data Object = NoObj | Obj position::Float
data Scene = Scene o1::Object, o2::Object
neural readScene :: (Symbol -> Scene)
g o = if isNoObj o then 0.0 else (if position o > 0.5 then 1.0 else 0.0)
main s = draw sc = readScene s in g (o1 sc) + g (o2 sc)
